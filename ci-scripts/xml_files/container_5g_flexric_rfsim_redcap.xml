        <testCase id="333331">
                <class>Attach_UE</class>
                <desc>Attach OAI UE 1</desc>
                <id>rfsim5g_redcap_ue1</id>
                <node>carabe</node>
        </testCase>

        <testCase id="302001">
                <class>Custom_Command</class>
                <desc>Verify UE 1 is normal (no RedCap)</desc>
                <node>localhost</node>
                <command>[ $(docker logs rfsim5g-oai-nr-ue1_redcap | grep -Ec "Built UE NR capability from nrue_recap YAML|nrue_recap RedCap config|Applying SIB1 RedCap initial (DL|UL) BWP") -eq 0 ]</command>
        </testCase>

        <testCase id="333332">
                <class>Attach_UE</class>
                <desc>Attach OAI UE 2 (RedCap)</desc>
                <id>rfsim5g_redcap_ue2</id>
                <node>carabe</node>
        </testCase>

        <testCase id="302002">
                <class>Custom_Command</class>
                <desc>Verify UE 2 is RedCap</desc>
                <node>localhost</node>
                <command>[ $(docker logs rfsim5g-oai-gnb_redcap | grep -m1 -E "UE with RNTI [0-9a-f]{4} is RedCap" | wc -l) -eq 1 ]</command>
        </testCase>

        <testCase id="302003">
                <class>Custom_Command</class>
                <desc>Verify gNB builds RedCap initial DL BWP into SIB1</desc>
                <node>localhost</node>
                <command>[ $(docker logs rfsim5g-oai-gnb_redcap | grep -m1 -E "SIB1 RedCap initial DL BWP|redCapInitialBWP_r17:" | wc -l) -eq 1 ]</command>
        </testCase>

        <testCase id="302004">
                <class>Custom_Command</class>
                <desc>Verify gNB builds RedCap initial UL BWP into SIB1</desc>
                <node>localhost</node>
                <command>[ $(docker logs rfsim5g-oai-gnb_redcap | grep -m1 -E "SIB1 RedCap initial UL BWP|initialULPUCCH_ResourceCommonRedCap_r17:" | wc -l) -eq 1 ]</command>
        </testCase>

        <testCase id="040001">
                <class>IdleSleep</class>
                <desc>Sleep for RedCap UE2 user-plane stabilization</desc>
                <idle_sleep_time_in_sec>5</idle_sleep_time_in_sec>
        </testCase>

        <testCase id="020005">
                <class>Ping</class>
                <desc>Ping ext-dn from both UEs</desc>
                <id>rfsim5g_redcap_ue1 rfsim5g_redcap_ue2</id>
                <node>carabe</node>
                <svr_id>oai_ext_dn</svr_id>
                <svr_node>carabe</svr_node>
                <ping_args>-c 20</ping_args>
                <ping_packetloss_threshold>5</ping_packetloss_threshold>
        </testCase>

        <testCase id="030001">
                <class>Iperf</class>
                <desc>Iperf RedCap UE2 (UL/50Mbps/UDP)(30 sec)</desc>
                <iperf_args>-u -b 50M -t 30</iperf_args>
                <id>rfsim5g_redcap_ue2</id>
                <node>carabe</node>
                <svr_id>oai_ext_dn</svr_id>
                <svr_node>carabe</svr_node>
                <iperf_packetloss_threshold>25</iperf_packetloss_threshold>
                <iperf_bitrate_threshold>85</iperf_bitrate_threshold>
                <iperf_profile>balanced</iperf_profile>
        </testCase>

        <testCase id="302005">
                <class>Custom_Command</class>
                <desc>Apply RedCap UL PRB cap to UE 2 via FlexRIC RC control</desc>
                <node>localhost</node>
                <command>if [ "${REDCAP_E2_AGENT_MODE:-enabled}" = "disabled" ]; then echo "Skipping RedCap UL PRB control in disabled E2 mode"; else REDCAP_UL_PRB_CAP=${REDCAP_UL_PRB_CAP:-32} ci-scripts/redcap_send_ul_prb_control.sh; fi</command>
        </testCase>

        <testCase id="302006">
                <class>Custom_Command</class>
                <desc>Verify gNB applied RedCap UL PRB cap</desc>
                <node>localhost</node>
                <command>if [ "${REDCAP_E2_AGENT_MODE:-enabled}" = "disabled" ]; then echo "Skipping gNB RedCap UL PRB verification in disabled E2 mode"; else [ $(docker logs rfsim5g-oai-gnb_redcap | grep -m1 "RedCap UL PRB control RNTI" | wc -l) -eq 1 ]; fi</command>
        </testCase>

        <testCase id="030002">
                <class>Iperf</class>
                <desc>Iperf RedCap UE2 (UL/20Mbps/UDP)(30 sec)</desc>
                <iperf_args>-u -b 20M -t 30</iperf_args>
                <id>rfsim5g_redcap_ue2</id>
                <node>carabe</node>
                <svr_id>oai_ext_dn</svr_id>
                <svr_node>carabe</svr_node>
                <iperf_packetloss_threshold>25</iperf_packetloss_threshold>
                <iperf_bitrate_threshold>85</iperf_bitrate_threshold>
                <iperf_profile>balanced</iperf_profile>
        </testCase>

